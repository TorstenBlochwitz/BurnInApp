<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:BurnInApp"
		mc:Ignorable="d"
		x:Class="BurnInApp.MainWindow"
		x:CompileBindings="False"
		Title="BurnIn App"
		Width="1227" Height="430"
		MinWidth="900" MinHeight="350"
		WindowStartupLocation="CenterScreen"
		Closing="MainWindow_Closing">
	<Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
			<Button x:Name="ConnectMbcButton"
					Content="Connect MBC"
					MinWidth="100"
					Click="ConnectMBC_Click" />
			<TextBox Grid.Column="1"
					 x:Name="MBCStatus"
					 IsReadOnly="True"
					 VerticalContentAlignment="Center"
					 PlaceholderText="Status..." />
		</Grid>

		<DataGrid Grid.Row="1"
				  x:Name="DataTable"
				  AutoGenerateColumns="False"
				  CanUserReorderColumns="False"
				  CanUserResizeColumns="True"
				  CanUserSortColumns="False"
				  GridLinesVisibility="All"
				  IsReadOnly="True"
				  HeadersVisibility="Column"
				  BorderBrush="Black"
					BorderThickness="1"
				  SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="" Width="72">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="Load..."
									Tag="{Binding BoardIndex}"
									Click="LoadProfile_Click" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Profile" Width="160" Binding="{ReflectionBinding Profile}" />
				<DataGridTemplateColumn Header="Serial Number" Width="145">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="{Binding SerialNumber}"
									HorizontalContentAlignment="Left"
									Tag="{Binding BoardIndex}"
									Click="EditSerialNumber_Click" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Start Time" Width="145" Binding="{ReflectionBinding StartTime}" />
				<DataGridTextColumn Header="End Time" Width="145" Binding="{ReflectionBinding EndTime}" />
				<DataGridTextColumn Header="Action" Width="130" Binding="{ReflectionBinding Action}" />
				<DataGridTextColumn Header="Status" Width="*" Binding="{ReflectionBinding Status}" />
				<DataGridTextColumn Header="VDC1" Width="75" Binding="{ReflectionBinding VDC1}" />
				<DataGridTextColumn Header="VDC2" Width="75" Binding="{ReflectionBinding VDC2}" />
				<DataGridTemplateColumn Header="" Width="75">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="{Binding StartButtonText}"
									IsEnabled="{Binding CanStart}"
									Tag="{Binding BoardIndex}"
									Click="Start_Click" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="" Width="75">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button Content="Reset"
									IsEnabled="{Binding CanReset}"
									Tag="{Binding BoardIndex}"
									Click="Reset_Click" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<Grid Grid.Row="2" ColumnDefinitions="Auto,*">
			<Button x:Name="StartAllButton"
					Content="Start all"
					MinWidth="100"
					IsEnabled="False"
					Click="StartAll_Click" />
			<Button Grid.Column="1"
					Content="Settings..."
					HorizontalAlignment="Right"
					MinWidth="100"
					Click="Settings_Click" />
		</Grid>
	</Grid>
</Window>