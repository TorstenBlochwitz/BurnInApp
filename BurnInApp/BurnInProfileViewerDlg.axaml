<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:BurnInApp"
		mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
		x:Class="BurnInApp.BurnInProfileViewerDlg"
		Title="Burn-In Profile Viewer"
		Width="900" Height="520"
		WindowStartupLocation="CenterOwner"
		CanResize="False">

	<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">
		<!-- File Name -->
		<DockPanel Grid.Row="0" Margin="0,0,0,5">
			<Label DockPanel.Dock="Left" Content="File:" Width="140" VerticalAlignment="Center"/>
			<TextBox x:Name="FileNameTextBox" IsReadOnly="True" VerticalAlignment="Center"/>
		</DockPanel>

		<!-- Profile Steps -->
		<DataGrid x:Name="ProfileDataGrid"
				  Grid.Row="1"
				  Margin="0,0,0,5"
				  AutoGenerateColumns="False"
				  CanUserReorderColumns="False"
				  CanUserResizeColumns="True"
				  CanUserSortColumns="False"
				  GridLinesVisibility="All"
				  HeadersVisibility="All"
				  BorderBrush="Gray"
				  BorderThickness="1"
				  RowHeight="22">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Step" Binding="{ReflectionBinding StepNumber}" IsReadOnly="True" Width="40"/>
				<DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}" IsReadOnly="True" Width="120"/>
				<DataGridTextColumn Header="Duration" Binding="{ReflectionBinding Duration}" IsReadOnly="True" Width="80"/>
				<DataGridTextColumn Header="Power1" Binding="{ReflectionBinding PowerPerChannel1}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="MaxI1" Binding="{ReflectionBinding MaxCurrent1}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="MaxU1" Binding="{ReflectionBinding MaxVoltage1}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="Freq1" Binding="{ReflectionBinding Frequency1}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="Duty1" Binding="{ReflectionBinding DutyCycle1}" IsReadOnly="True" Width="50"/>
				<DataGridTextColumn Header="VDuT1" Binding="{ReflectionBinding ComputeVDuT1}" IsReadOnly="True" Width="50"/>
				<DataGridTextColumn Header="Power2" Binding="{ReflectionBinding PowerPerChannel2}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="MaxI2" Binding="{ReflectionBinding MaxCurrent2}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="MaxU2" Binding="{ReflectionBinding MaxVoltage2}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="Freq2" Binding="{ReflectionBinding Frequency2}" IsReadOnly="True" Width="60"/>
				<DataGridTextColumn Header="Duty2" Binding="{ReflectionBinding DutyCycle2}" IsReadOnly="True" Width="50"/>
				<DataGridTextColumn Header="VDuT2" Binding="{ReflectionBinding ComputeVDuT2}" IsReadOnly="True" Width="50"/>
				<DataGridTextColumn Header="Measure" Binding="{ReflectionBinding Measure}" IsReadOnly="True" Width="60"/>
			</DataGrid.Columns>
			<DataGrid.Styles>
				<Style Selector="DataGridColumnHeader">
					<Setter Property="Background" Value="LightGray"/>
					<Setter Property="FontWeight" Value="Normal"/>
					<Setter Property="FontSize" Value="12"/>
					<Setter Property="Height" Value="22"/>
					<Setter Property="Padding" Value="5,2"/>
				</Style>
				<Style Selector="DataGridCell">
					<Setter Property="FontSize" Value="12"/>
					<Setter Property="Padding" Value="5,2"/>
				</Style>
			</DataGrid.Styles>
		</DataGrid>

		<!-- Bank panels and Measurement Rate -->
		<Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,5">
			<Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0" Padding="8">
				<StackPanel Spacing="3">
					<Label Content="Bank 1" FontWeight="Bold"/>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Type:" Width="90" VerticalAlignment="Center"/>
						<TextBox x:Name="Type1TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Number:" Width="90" VerticalAlignment="Center"/>
						<TextBox x:Name="Number1TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Resistance:" Width="90" VerticalAlignment="Center"/>
						<Label DockPanel.Dock="Right" Content="Ohm" VerticalAlignment="Center" Margin="5,0,0,0"/>
						<TextBox x:Name="Resistance1TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Deviation:" Width="90" VerticalAlignment="Center"/>
						<Label DockPanel.Dock="Right" Content="Ohm" VerticalAlignment="Center" Margin="5,0,0,0"/>
						<TextBox x:Name="Deviation1TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
				</StackPanel>
			</Border>

			<Border x:Name="Bank2Panel" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0" Padding="8">
				<StackPanel Spacing="3">
					<Label Content="Bank 2" FontWeight="Bold"/>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Type:" Width="90" VerticalAlignment="Center"/>
						<TextBox x:Name="Type2TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Number:" Width="90" VerticalAlignment="Center"/>
						<TextBox x:Name="Number2TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Resistance:" Width="90" VerticalAlignment="Center"/>
						<Label DockPanel.Dock="Right" Content="Ohm" VerticalAlignment="Center" Margin="5,0,0,0"/>
						<TextBox x:Name="Resistance2TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
					<DockPanel>
						<Label DockPanel.Dock="Left" Content="Deviation:" Width="90" VerticalAlignment="Center"/>
						<Label DockPanel.Dock="Right" Content="Ohm" VerticalAlignment="Center" Margin="5,0,0,0"/>
						<TextBox x:Name="Deviation2TextBox" IsReadOnly="True" VerticalAlignment="Center"/>
					</DockPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Measurement Rate and Close button -->
		<Grid Grid.Row="3" ColumnDefinitions="*,Auto">
			<DockPanel Grid.Column="0" VerticalAlignment="Center">
				<Label DockPanel.Dock="Left" Content="Measurement Rate:" Width="140" VerticalAlignment="Center"/>
				<TextBox x:Name="MeasurementRateTextBox" IsReadOnly="True" VerticalAlignment="Center" Width="120" HorizontalAlignment="Left"/>
			</DockPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
				<Button Content="Close" Width="90" Click="Close_Click" IsDefault="True" IsCancel="True" HorizontalContentAlignment="Center"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>
