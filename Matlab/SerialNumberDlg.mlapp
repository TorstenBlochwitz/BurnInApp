classdef SerialNumberDlg < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure           matlab.ui.Figure
        Label              matlab.ui.control.Label
        AA0001ZZ9999Label  matlab.ui.control.Label
        CancelButton       matlab.ui.control.Button
        OKButton           matlab.ui.control.Button
        Number             matlab.ui.control.NumericEditField
        LastPositionLabel  matlab.ui.control.Label
        SerialNumber       matlab.ui.control.EditField
        SerialNumberLabel  matlab.ui.control.Label
    end

    
    properties (Access = private)
        main
    end
    

    % Callbacks that handle component events
    methods (Access = private)

        % Code that executes after component creation
        function Initialize(app, burnInApp)
            app.main = burnInApp;
            app.UIFigure.Name = 'Serial Number';
            app.SerialNumber.Value = app.main.burnInController.serialNumber(app.main.currBoard);
            app.Label.Text = sprintf("1 ... %d", app.main.burnInController.GetMaxNofEmitters(app.main.currBoard));
            app.Number.Limits = [1, app.main.burnInController.GetMaxNofEmitters(app.main.currBoard)];
            app.Number.Value = min(app.main.burnInController.numberOfEmitters(app.main.currBoard), app.main.burnInController.GetMaxNofEmitters(app.main.currBoard));
            focus(app.SerialNumber);
        end

        % Button pushed function: OKButton
        function OKButtonPushed(app, event)
            if ~isempty(app.SerialNumber.Value)
                [b, SNr] = getSNr(app.SerialNumber.Value, 0);
                if b
                    app.main.burnInController.serialNumber(app.main.currBoard) = SNr;
                    app.main.burnInController.numberOfEmitters(app.main.currBoard) = app.Number.Value;
                    [~, SNrend] = getSNr(SNr, app.Number.Value);
                    app.main.Status.Data{app.main.currBoard,2} = sprintf('%s - %s', SNr, SNrend);
                    delete(app);
                else
                    uialert(app.UIFigure, sprintf("'%s* is not a valid Serialnumber.\n\nEnter a valid Serialnumber for example 'AA0001'", app.SerialNumber.Value), "Error in Serialnumber");
                end
            else
                app.main.burnInController.serialNumber(app.main.currBoard) = "";
                delete(app);
            end
        end

        % Button pushed function: CancelButton
        function CancelButtonPushed(app, event)
            delete(app);
        end
    end

    % Component initialization
    methods (Access = private)

        % Create UIFigure and components
        function createComponents(app)

            % Create UIFigure and hide until all components are created
            app.UIFigure = uifigure('Visible', 'off');
            app.UIFigure.AutoResizeChildren = 'off';
            app.UIFigure.Position = [100 100 344 179];
            app.UIFigure.Name = 'MATLAB App';
            app.UIFigure.Resize = 'off';
            app.UIFigure.BusyAction = 'cancel';
            app.UIFigure.Interruptible = 'off';
            app.UIFigure.WindowStyle = 'modal';

            % Create SerialNumberLabel
            app.SerialNumberLabel = uilabel(app.UIFigure);
            app.SerialNumberLabel.HorizontalAlignment = 'right';
            app.SerialNumberLabel.Position = [12 141 85 22];
            app.SerialNumberLabel.Text = 'Serial Number:';

            % Create SerialNumber
            app.SerialNumber = uieditfield(app.UIFigure, 'text');
            app.SerialNumber.CharacterLimits = [6 6];
            app.SerialNumber.Position = [104 141 91 22];

            % Create LastPositionLabel
            app.LastPositionLabel = uilabel(app.UIFigure);
            app.LastPositionLabel.HorizontalAlignment = 'right';
            app.LastPositionLabel.Position = [12 111 77 22];
            app.LastPositionLabel.Text = 'Last Position:';

            % Create Number
            app.Number = uieditfield(app.UIFigure, 'numeric');
            app.Number.Limits = [1 120];
            app.Number.AllowEmpty = 'on';
            app.Number.HorizontalAlignment = 'left';
            app.Number.Position = [104 111 91 22];
            app.Number.Value = [];

            % Create OKButton
            app.OKButton = uibutton(app.UIFigure, 'push');
            app.OKButton.ButtonPushedFcn = createCallbackFcn(app, @OKButtonPushed, true);
            app.OKButton.Position = [136 15 91 23];
            app.OKButton.Text = 'OK';

            % Create CancelButton
            app.CancelButton = uibutton(app.UIFigure, 'push');
            app.CancelButton.ButtonPushedFcn = createCallbackFcn(app, @CancelButtonPushed, true);
            app.CancelButton.Position = [240 15 91 23];
            app.CancelButton.Text = 'Cancel';

            % Create AA0001ZZ9999Label
            app.AA0001ZZ9999Label = uilabel(app.UIFigure);
            app.AA0001ZZ9999Label.Position = [201 141 106 22];
            app.AA0001ZZ9999Label.Text = 'AA0001 ... ZZ9999';

            % Create Label
            app.Label = uilabel(app.UIFigure);
            app.Label.Position = [201 111 48 22];
            app.Label.Text = '1 ... 120';

            % Show the figure after all components are created
            app.UIFigure.Visible = 'on';
        end
    end

    % App creation and deletion
    methods (Access = public)

        % Construct app
        function app = SerialNumberDlg(varargin)

            runningApp = getRunningApp(app);

            % Check for running singleton app
            if isempty(runningApp)

                % Create UIFigure and components
                createComponents(app)

                % Register the app with App Designer
                registerApp(app, app.UIFigure)

                % Execute the startup function
                runStartupFcn(app, @(app)Initialize(app, varargin{:}))
            else

                % Focus the running singleton app
                figure(runningApp.UIFigure)

                app = runningApp;
            end

            if nargout == 0
                clear app
            end
        end

        % Code that executes before app deletion
        function delete(app)

            % Delete UIFigure when app is deleted
            delete(app.UIFigure)
        end
    end
end