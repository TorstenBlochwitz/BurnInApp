classdef BurnInApp < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        BurnInAppUIFigure        matlab.ui.Figure
        RunningLamp              matlab.ui.control.Lamp
        ShowStatusTableCheckBox  matlab.ui.control.CheckBox
        StartAll                 matlab.ui.control.Button
        Settings                 matlab.ui.control.Button
        TestButton               matlab.ui.control.Button
        ResetButton8             matlab.ui.control.Button
        ResetButton7             matlab.ui.control.Button
        ResetButton6             matlab.ui.control.Button
        ResetButton5             matlab.ui.control.Button
        ResetButton4             matlab.ui.control.Button
        ResetButton3             matlab.ui.control.Button
        ResetButton2             matlab.ui.control.Button
        ResetButton1             matlab.ui.control.Button
        StartButton8             matlab.ui.control.Button
        StartButton7             matlab.ui.control.Button
        StartButton6             matlab.ui.control.Button
        StartButton5             matlab.ui.control.Button
        StartButton4             matlab.ui.control.Button
        StartButton3             matlab.ui.control.Button
        StartButton2             matlab.ui.control.Button
        StartButton1             matlab.ui.control.Button
        DMM6500IDEditField       matlab.ui.control.EditField
        DMMStatus                matlab.ui.control.EditField
        ConnectDMM               matlab.ui.control.Button
        MBCStatus                matlab.ui.control.EditField
        Label                    matlab.ui.control.Label
        ConnectMBC               matlab.ui.control.Button
        LoadButton8              matlab.ui.control.Button
        LoadButton7              matlab.ui.control.Button
        LoadButton6              matlab.ui.control.Button
        LoadButton5              matlab.ui.control.Button
        LoadButton4              matlab.ui.control.Button
        LoadButton3              matlab.ui.control.Button
        LoadButton2              matlab.ui.control.Button
        LoadButton1              matlab.ui.control.Button
        Status                   matlab.ui.control.Table
    end

    
    properties (Access = private)
        burnInProfileViewer;
        burnInSettingsDlg;

        strStatus =  strings([8,4]);

        ActionTimer;

        connecting = false;
        closing = false;
        showStatusTable = true;
        lampColor = [0.0 1.0 0.0];
        lampOn = false;
        resetButton;
        startButton;
        loadButton;
        autoTableSwitchOffTime;
        currAction = ["" "" "" "" "" "" "" ""];
    end

    properties (Access = public)
        timerRunning = false;
        burnInController BurnInController;
        currBoard = 0;
    end
    methods (Access = public)
        function doSomething(app, i)
            printf("doSomethingCalled with i = %d", i);
        end
    end

    methods (Access = private)
        
        function ret = ActionTimerFunc(app,~,~)
            ret = 0;
            %fprintf("Timer running\n")
            app.timerRunning = true;

            if ~app.showStatusTable
                app.RunningLamp.Visible="on";
                if app.lampOn
                    app.RunningLamp.Color = 0.5 * app.lampColor;
                    app.lampOn = false;
                else
                    app.RunningLamp.Color = app.lampColor;
                    app.lampOn = true;
                end
            else
                app.RunningLamp.Visible="off";
            end
            if ~app.connecting && ~app.closing
                try
                    currDevice = app.burnInController.currActionDevice;
                    if isvalid(app.burnInController.mbc)
                        app.currAction = ["" "" "" "" "" "" "" ""];
                        app.currAction(currDevice) = app.burnInController.burnInAction(currDevice).getActionString();
                        if app.showStatusTable
                            for k=1:1:8
                                app.Status.Data{k, 5} = convertStringsToChars(app.currAction(k));
                            end
                            drawnow();
                        end
                    end
                    
                    app.burnInController.doAction();
                    if app.showStatusTable
                        app.Status.Data{currDevice, 5} = '';
                    end

                    if ~app.connecting && ~app.closing
                        app.updateVisibility();
                    end
                catch e
                    fprintf("Timer exception catched: %s\n", e.message);
                end
            else
                app.burnInController.writeMemoryUsage(false);
            end
            app.timerRunning = false;
            %fprintf("Timer finished\n")
        end
        %removing styles avoids increasing runtime of updateVisibility()
        function removeCellStyles(app)
            styles = app.Status.StyleConfigurations;
            %going backwards ensures that size is not exceeded
            for k=size(styles, 1):-1:1
                if styles{k,1} == categorical(cellstr('cell'))
                    app.Status.removeStyle(k);
                end
            end
        end
        function updateVisibility(app)
            try
                if app.showStatusTable && app.burnInController.settings.autoTableSwitchOff && app.autoTableSwitchOffTime < datetime('now', 'Format', 'yyyy-MM-dd HH:mm:ss')
                    app.showStatusTable = false;
                    app.ShowStatusTableCheckBox.Value = 0;
                end
                if app.showStatusTable
                    app.Status.Visible="on";
                else
                    app.Status.Visible="off";
                    app.lampColor = [0.0 1.0 0.0];
                    for k=1:1:8
                        [~, isError] = app.burnInController.getStatusColor(k);
                        if isError
                            app.lampColor = [1.0 0.0 0.0];
                            break;
                        end
                    end

                end
                if ~app.closing
                    enableStartAllButton = false;
                    if app.showStatusTable
                        %if we don't do this, the app gets slower and slower because we call addStyle later
                        app.removeCellStyles();
                    end
                    app.MBCStatus.Value = app.burnInController.MBCStatusString;
                    if isempty(isvalid(app.burnInController.mbc)) || ~isvalid(app.burnInController.mbc) % w.t.f: isvalid delivers an empty(!) logical array if the argument is NULL, if the argument was deleted, it returns false
                        app.ConnectMBC.Enable = true;
                        app.lampColor = [1.0 0.0 0.0];
                        app.MBCStatus.FontColor = [1.0 0.0 0.0];
                        for k=1:1:8
                            %disable all buttons except Load Profile buttons
                            app.startButton(k).Enable = false;
                            app.resetButton(k).Enable = false;
                            if app.showStatusTable
                                app.Status.Data{k,6} = convertStringsToChars(app.burnInController.getStatusString(k));
                                addStyle(app.Status,uistyle('BackgroundColor',app.burnInController.getStatusColor(k)),'cell',[k,6]);
                            end
                        end
                    else
                        app.ConnectMBC.Enable = false;
                        app.MBCStatus.FontColor = [0.0 0.0 0.0];
                        SNrDisplayUpdateNeeded = app.burnInController.SNrDisplayUpdateNeeded;
                        for k=1:1:8
                            status = app.burnInController.burnInProfile(k).getStatus();
                            if app.showStatusTable
                                app.Status.Data{k,6} = convertStringsToChars(app.burnInController.getStatusString(k));
                                addStyle(app.Status,uistyle('BackgroundColor',app.burnInController.getStatusColor(k)),'cell',[k,6]);
                                
                                if app.burnInController.serialNumber(k) == ""
                                    if (app.burnInController.burnInStatus(k).getStatus() > BurnInStatusEnum.DCDC_CONNECTED) && ...
                                       (app.burnInController.burnInProfile(k).isProfileLoaded())
                                        app.Status.Data{k,2} = sprintf('...');
                                    else
                                        app.Status.Data{k,2} = sprintf('');
                                    end
                                end
                                if SNrDisplayUpdateNeeded
                                    app.burnInController.SNrDisplayUpdateNeeded = false;
                                    if app.burnInController.serialNumber(k) ~= ""
                                        [~, SNrend] = getSNr(app.burnInController.serialNumber(k), app.burnInController.numberOfEmitters(k));
                                        app.Status.Data{k,2} = sprintf('%s - %s', app.burnInController.serialNumber(k), SNrend);
                                    else
                                        app.Status.Data{k,2} = sprintf('');
                                    end
                                end
                                if status == ProfileStatusEnum.RUNNING
                                    app.Status.Data{k,4} = convertStringsToChars(sprintf("%s", app.burnInController.burnInProfile(k).stopTime));
                                end
                            end
    
                            app.loadButton(k).Enable = (status == ProfileStatusEnum.EMPTY) ||...
                                                       (status == ProfileStatusEnum.READY_TO_RUN);
                            
                            if status == ProfileStatusEnum.FINISHED
                                app.startButton(k).Enable = false;
                                app.resetButton(k).Enable = true;
                            else
                                if (app.burnInController.burnInStatus(k).getStatus() > BurnInStatusEnum.DCDC_CONNECTED) &&...
                                    ((status == ProfileStatusEnum.READY_TO_RUN) || ...
                                    ((status == ProfileStatusEnum.RUNNING) && (app.burnInController.burnInProfile(k).currProfileStep > 0))|| ...
                                    (status == ProfileStatusEnum.STOPPED_SHORTCIRCUIT) || ...
                                    (status == ProfileStatusEnum.STOPPED_MANUALLY) || ...
                                    (status == ProfileStatusEnum.STOPPED_ERROR)) &&...
                                    (strlength(app.burnInController.serialNumber(k)) > 0)
                                    app.startButton(k).Enable = true;
                                    if status ~= ProfileStatusEnum.RUNNING
                                        enableStartAllButton = true;
                                    end
                                    if  (status == ProfileStatusEnum.STOPPED_MANUALLY) || ... 
                                        (status == ProfileStatusEnum.STOPPED_SHORTCIRCUIT) || ...
                                        (status == ProfileStatusEnum.STOPPED_ERROR)
                                        app.resetButton(k).Enable = true;
                                        app.startButton(k).Text = 'Continue';
                                    else
                                        app.resetButton(k).Enable = false;
                                    end
                                else
                                    app.startButton(k).Enable = false;
                                    app.resetButton(k).Enable = false;
                                end
                            end
                            if app.showStatusTable
                                if  (status == ProfileStatusEnum.RUNNING) || ...
                                    (status == ProfileStatusEnum.STOPPED_ERROR)
                                    [strVDC1, colVDC1] = app.burnInController.VDC1status(k).getStatusStringColor(app.burnInController.VDC1measured(k));
                                    [strVDC2, colVDC2] = app.burnInController.VDC2status(k).getStatusStringColor(app.burnInController.VDC2measured(k));
                                    app.Status.Data{k,7} = convertStringsToChars(strVDC1);
                                    app.Status.Data{k,8} = convertStringsToChars(strVDC2);
                                    addStyle(app.Status,uistyle('BackgroundColor',colVDC1),'cell',[k,7]);
                                    addStyle(app.Status,uistyle('BackgroundColor',colVDC2),'cell',[k,8]);
                                else
                                    app.Status.Data{k,7} = '';
                                    app.Status.Data{k,8} = '';
                                end
                            end
                        end
                    end
                    app.StartAll.Enable = enableStartAllButton;
                    if isvalid(app.burnInController.dmm)
                        app.ConnectDMM.Enable = false;
                        app.DMM6500IDEditField.Enable = false;
                    else
                        app.ConnectDMM.Enable = true;
                        app.DMM6500IDEditField.Enable = true;
                    end
                    drawnow();
                end
            catch e
                fprintf("Exception in app.updateVisibility: %s", e.message);
            end
        end
        
        function connectMBC(app)
            app.connecting = true;
            app.MBCStatus.FontColor = [0.0 0.0 0.0];
            app.MBCStatus.Value = 'Connecting...';
            drawnow();
            %app.burnInController.connectMBC(app.MBC_Port.Value);
            app.burnInController.connectMBC(app.burnInController.settings.GetMBCPort());
            app.MBCStatus.Value = app.burnInController.MBCStatusString;
            app.connecting = false;
        end
        function connectDMM(app)
            app.connecting = true;
            app.DMMStatus.Value = 'Connecting...';
            drawnow();
            app.burnInController.connectDMM(app.DMM6500IDEditField.Value);
            app.DMMStatus.Value = app.burnInController.DMMStatusString;
            app.connecting = false;
        end
        
        function ret = getButtonIndex(app, button)
            ret = 0;
            for i=1:1:8
                if (button == app.startButton(i)) || (button == app.loadButton(i)) || (button == app.resetButton(i))
                    ret = i;
                end
            end
        end
        
        function startAutoSwitchOffTime(app)
            if app.burnInController.settings.autoTableSwitchOff
                app.autoTableSwitchOffTime = datetime('now', 'Format', 'yyyy-MM-dd HH:mm:ss') + minutes(app.burnInController.settings.autoTableSwitchOffTime);
                app.showStatusTable = true;
                app.ShowStatusTableCheckBox.Value = 1;
            end
        end
    end
    

    % Callbacks that handle component events
    methods (Access = private)

        % Code that executes after component creation
        function Initialize(app)
            app.burnInController = BurnInController();
            app.burnInController.writeMemoryUsage(true);
            app.BurnInAppUIFigure.Name = convertStringsToChars(app.burnInController.getAppTitle());
            
            %app.MBC_Port.Value = app.burnInController.settings.MBC_Port;
            app.DMM6500IDEditField.Value = app.burnInController.settings.DMM6500_ID;

            app.resetButton = [app.ResetButton1 app.ResetButton2 app.ResetButton3 app.ResetButton4 app.ResetButton5 app.ResetButton6 app.ResetButton7 app.ResetButton8];
            app.startButton = [app.StartButton1 app.StartButton2 app.StartButton3 app.StartButton4 app.StartButton5 app.StartButton6 app.StartButton7 app.StartButton8];
            app.loadButton = [app.LoadButton1 app.LoadButton2 app.LoadButton3 app.LoadButton4 app.LoadButton5 app.LoadButton6 app.LoadButton7 app.LoadButton8];
            app.Status.RowName = {'1'; '2'; '3'; '4';'5';'6';'7';'8'};
            sWhite = uistyle('BackgroundColor','white');
            for k=1:1:8
                addStyle(app.Status, sWhite, 'row', k);
            end
            
            app.connectMBC();
                        
            app.connectDMM();
            %USB0::0x05E6::0x6500::04546108::INSTR
            app.startAutoSwitchOffTime();
            
            app.updateVisibility();

            app.ActionTimer = timer('ExecutionMode', 'fixedSpacing', 'Period', 0.5, 'BusyMode', 'drop', 'TimerFcn', @app.ActionTimerFunc);
            start(app.ActionTimer);
        end

        % Button pushed function: LoadButton1, LoadButton2, LoadButton3, 
        % ...and 5 other components
        function LoadButtonPushed(app, event)
            k = app.getButtonIndex(event.Source);
            if k ~= 0
                [file,path] = uigetfile('*.xlsx', 'Select a Profile Definition file', app.burnInController.settings.folderBurnInProfiles);
                if ~(isequal(file,0) || isequal(path,0))
                    [ret, status] = app.burnInController.burnInProfile(k).readFromExcelFile(fullfile(path,file));
                    if ret ~= 1
                        uiwait(msgbox(status,"Error","error"));
                        app.Status.Data{k,1} = '';
                    else
                        app.Status.Data{k,1} = app.burnInController.burnInProfile(k).getFileName();
                        %reset Serial number and number of emitters
                        app.burnInController.serialNumber(k) = '';
                        app.burnInController.numberOfEmitters(k) = 120;
                        app.Status.Data{k,2} = '';
                    end
                end
            end
            app.startAutoSwitchOffTime();
            %workaround to bring app window to foreground
            drawnow();
            figure(app.BurnInAppUIFigure);
            app.updateVisibility();
            drawnow();
        end

        % Close request function: BurnInAppUIFigure
        function BurnInAppUIFigureCloseRequest(app, event)
            %TODO: Check if a BurnIn Process is running
            %TODO: Check if a long lasting Measurement is running
            yesSwitchOff = 'Yes and Switch Off';
            yesKeep = 'Yes and Keep On';
            no = 'No';
            answer = questdlg('Do you really want to close the BurnInApplication?', 'Close',yesSwitchOff, yesKeep, no, no);
            if strcmp(answer, yesSwitchOff) || strcmp(answer, yesKeep)
                app.closing = true;
                stop(app.ActionTimer);
                delete(app.ActionTimer);
                
                if strcmp(answer, yesSwitchOff)
                    app.burnInController.statusFile.addMsg(msgLevel.SETUP, "Switching off");
                    %TDOD: Should be done in ActionLoop!
                    app.burnInController.switchOffEverything();
                end
                %app.burnInController.settings.MBC_Port = app.MBC_Port.Value;
                app.burnInController.settings.DMM6500_ID = app.DMM6500IDEditField.Value;
                delete(app);
            end      
        end

        % Button pushed function: ConnectMBC
        function ConnectMBCButtonPushed(app, event)
            app.startAutoSwitchOffTime();
            app.connectMBC();
            app.updateVisibility();
        end

        % Button pushed function: ConnectDMM
        function ConnectDMMButtonPushed(app, event)
            app.connectDMM();
            app.startAutoSwitchOffTime();
            app.updateVisibility();
        end

        % Clicked callback: Status
        function StatusClicked(app, event)
            displayRow = event.InteractionInformation.DisplayRow;
            displayColumn = event.InteractionInformation.DisplayColumn;
            if displayRow > 0
                if displayColumn == 1 && app.burnInController.burnInProfile(displayRow).getNoSteps() > 0
                    app.burnInProfileViewer = BurnInProfileViewer(app.burnInController.burnInProfile(displayRow), app.burnInController.burnInDev(displayRow).GetNofBanks());
                    %uiwait(app.burnInProfileViewer.UIFigure);
                    %workaround to bring app window to foreground
                    drawnow();
                    figure(app.BurnInAppUIFigure);
                elseif displayColumn == 2
                    status = app.burnInController.burnInProfile(displayRow).getStatus();
                    if  (app.burnInController.burnInStatus(displayRow).getStatus() > BurnInStatusEnum.DCDC_CONNECTED) && ...
                        (app.burnInController.burnInProfile(displayRow).isProfileLoaded()) && ...
                        (status ~= ProfileStatusEnum.RUNNING) && ...
                        (status ~= ProfileStatusEnum.STOPPED_MANUALLY) && ... 
                        (status ~= ProfileStatusEnum.STOPPED_ERROR)
                        app.currBoard = displayRow;
                        SerialNumberDlg(app);
                        drawnow();
                        figure(app.BurnInAppUIFigure);
                    end
                end
                app.startAutoSwitchOffTime();
                app.updateVisibility();
            end
        end

        % Button pushed function: StartAll, StartButton1, StartButton2, 
        % ...and 6 other components
        function StartButtonPushed(app, event)
            %iStartButton gets 0 if startAll button is pressed
            iStartButton = app.getButtonIndex(event.Source);
            if iStartButton ~= 0
                kStart = iStartButton;
                kEnd = iStartButton;
            else
                kStart = 1;
                kEnd = 8;
            end
            for k=kStart:1:kEnd
                if app.startButton(k).Enable
                    switch app.burnInController.burnInProfile(k).getStatus()
                        case ProfileStatusEnum.READY_TO_RUN
                            %Run
                            app.burnInController.requestNewProfileStatus(k, ProfileStatusEnum.RUN_REQUESTED);
                            %Estimate start and stop time
                            now = datetime('now', 'Format', 'yyyy-MM-dd HH:mm:ss');
                            app.Status.Data{k,3} = convertStringsToChars(sprintf("%s", now));
                            app.Status.Data{k,4} = convertStringsToChars(sprintf("%s", now + app.burnInController.burnInProfile(k).getDuration()));
                            app.startButton(k).Text = 'Stop';
                        case ProfileStatusEnum.RUNNING
                            %Stop
                            %don't Stop if StartAll Button was pressed
                            if iStartButton ~= 0
                                app.burnInController.requestNewProfileStatus(k, ProfileStatusEnum.STOP_REQUESTED_MANUALLY);
                                %Empty stop time
                                app.Status.Data{k,4} = '';
                                app.startButton(k).Text = 'Continue';
                            end
                        case ProfileStatusEnum.STOPPED_MANUALLY
                            %Continue after manual stop
                            app.burnInController.requestNewProfileStatus(k, ProfileStatusEnum.CONTINUE_REQUESTED);
                            %Update stop time
                            app.Status.Data{k,4} = convertStringsToChars(sprintf("%s", app.burnInController.burnInProfile(k).stopTime));
                            app.startButton(k).Text = 'Stop';
                        case ProfileStatusEnum.STOPPED_SHORTCIRCUIT
                            %Continue after short circuit detected
                            app.burnInController.requestNewProfileStatus(k, ProfileStatusEnum.CONTINUE_REQUESTED);
                            app.Status.Data{k,4} = convertStringsToChars(sprintf("%s", app.burnInController.burnInProfile(k).stopTime));
                            app.startButton(k).Text = 'Stop';
                        case ProfileStatusEnum.STOPPED_ERROR
                            %Continue after Error
                            app.burnInController.requestNewProfileStatus(k, ProfileStatusEnum.CONTINUE_REQUESTED_AFTER_ERROR);
                            app.Status.Data{k,4} = convertStringsToChars(sprintf("%s", app.burnInController.burnInProfile(k).stopTime));
                            app.startButton(k).Text = 'Stop';
                    end
                end
                app.startAutoSwitchOffTime();
                app.updateVisibility();
            end
        end

        % Button pushed function: ResetButton1, ResetButton2, 
        % ...and 6 other components
        function ResetButtonPushed(app, event)
            k = app.getButtonIndex(event.Source);
            if k ~= 0
                app.burnInController.requestNewProfileStatus(k, ProfileStatusEnum.RESET_REQUESTED);
                app.Status.Data{k,3} = '';
                app.Status.Data{k,4} = '';
                app.Status.Data{k,2} = '';
                app.startButton(k).Text = 'Start';
                app.startAutoSwitchOffTime();
                app.updateVisibility();
                drawnow();
            end
        end

        % Button pushed function: TestButton
        function TestButtonPushed(app, event)
            %app.burnInController.checkShortCircuit(1);
            app.burnInController.initialMeasurement(1);
        end

        % Button pushed function: Settings
        function SettingsButtonPushed(app, event)
            app.burnInSettingsDlg = BurnInSettingsDlg(app);
            %workaround to bring app window to foreground
            drawnow();
            figure(app.BurnInAppUIFigure);
            app.startAutoSwitchOffTime();
        end

        % Value changed function: ShowStatusTableCheckBox
        function ShowStatusTableCheckBoxValueChanged(app, event)
            app.showStatusTable = app.ShowStatusTableCheckBox.Value;
            app.autoTableSwitchOffTime = datetime('now', 'Format', 'yyyy-MM-dd HH:mm:ss') + minutes(app.burnInController.settings.autoTableSwitchOffTime);
            app.updateVisibility();
            %Update current action
            for k=1:1:8
                app.Status.Data{k, 5} = convertStringsToChars(app.currAction(k));
            end
            drawnow();
        end
    end

    % Component initialization
    methods (Access = private)

        % Create UIFigure and components
        function createComponents(app)

            % Create BurnInAppUIFigure and hide until all components are created
            app.BurnInAppUIFigure = uifigure('Visible', 'off');
            app.BurnInAppUIFigure.Position = [100 100 1227 372];
            app.BurnInAppUIFigure.Name = 'BurnIn App';
            app.BurnInAppUIFigure.CloseRequestFcn = createCallbackFcn(app, @BurnInAppUIFigureCloseRequest, true);

            % Create Status
            app.Status = uitable(app.BurnInAppUIFigure);
            app.Status.ColumnName = {'Profile'; 'Serial Number'; 'Start Time'; 'End Time'; 'Action'; 'Status'; 'VDC1'; 'VDC2'};
            app.Status.ColumnWidth = {160, 'auto', 'auto', 'auto', 'auto', 'auto', 50, 50};
            app.Status.RowName = {};
            app.Status.ColumnEditable = [false false false false false false false false];
            app.Status.ClickedFcn = createCallbackFcn(app, @StatusClicked, true);
            app.Status.BusyAction = 'cancel';
            app.Status.Interruptible = 'off';
            app.Status.Position = [105 42 967 248];

            % Create LoadButton1
            app.LoadButton1 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton1.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton1.BusyAction = 'cancel';
            app.LoadButton1.Interruptible = 'off';
            app.LoadButton1.Position = [7 237 90 23];
            app.LoadButton1.Text = 'Load...';

            % Create LoadButton2
            app.LoadButton2 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton2.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton2.BusyAction = 'cancel';
            app.LoadButton2.Interruptible = 'off';
            app.LoadButton2.Position = [7 214 90 23];
            app.LoadButton2.Text = 'Load...';

            % Create LoadButton3
            app.LoadButton3 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton3.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton3.BusyAction = 'cancel';
            app.LoadButton3.Interruptible = 'off';
            app.LoadButton3.Position = [7 191 90 23];
            app.LoadButton3.Text = 'Load...';

            % Create LoadButton4
            app.LoadButton4 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton4.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton4.BusyAction = 'cancel';
            app.LoadButton4.Interruptible = 'off';
            app.LoadButton4.Position = [7 168 90 23];
            app.LoadButton4.Text = 'Load...';

            % Create LoadButton5
            app.LoadButton5 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton5.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton5.BusyAction = 'cancel';
            app.LoadButton5.Interruptible = 'off';
            app.LoadButton5.Position = [7 145 90 23];
            app.LoadButton5.Text = 'Load...';

            % Create LoadButton6
            app.LoadButton6 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton6.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton6.BusyAction = 'cancel';
            app.LoadButton6.Interruptible = 'off';
            app.LoadButton6.Position = [7 122 90 23];
            app.LoadButton6.Text = 'Load...';

            % Create LoadButton7
            app.LoadButton7 = uibutton(app.BurnInAppUIFigure, 'push');
            app.LoadButton7.ButtonPushedFcn = createCallbackFcn(app, @LoadButtonPushed, true);
            app.LoadButton7.BusyAction = 'cancel';
            app.LoadButton7.Interruptible = 'off';
            app.LoadButton7.Position = [7 99 90 23];
