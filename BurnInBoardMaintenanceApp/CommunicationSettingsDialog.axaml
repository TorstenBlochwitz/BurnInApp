<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="BurnInBoardMaintenanceApp.CommunicationSettingsDialog"
		Title="Communication Settings"
		Width="520" Height="220"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
	<Grid RowDefinitions="*,Auto" Margin="16">
		<TextBlock Text="CommunicationSettingsDlg is not ported yet. This placeholder dialog is wired now so the real communication settings workflow can be implemented later without reshaping the main window."
				   TextWrapping="Wrap"
				   VerticalAlignment="Center"/>
		<Button Grid.Row="1" Content="Close" HorizontalAlignment="Center" MinWidth="100" Click="CloseButton_Click"/>
	</Grid>
</Window>
