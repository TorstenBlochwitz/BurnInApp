<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="BurnInBoardMaintenanceApp.BurnInBoardMaintenanceMeasDialog"
		Title="Measurement"
		Width="520" Height="220"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
	<Grid RowDefinitions="*,Auto" Margin="16">
		<TextBlock Text="BurnInBoardMaintenanceMeasApp is not ported yet. This placeholder keeps the main maintenance app workflow intact until the dedicated measurement dialog is transferred later."
				   TextWrapping="Wrap"
				   VerticalAlignment="Center"/>
		<Button Grid.Row="1" Content="Close" HorizontalAlignment="Center" MinWidth="100" Click="CloseButton_Click"/>
	</Grid>
</Window>
